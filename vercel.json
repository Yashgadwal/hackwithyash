{
  "version": 2,
  "rewrites": [
    {
      "source": "/videos/:file*",
      "destination": "/api/video?file=:file*"
    },
    {
      "source": "/links",
      "destination": "/links.html"
    },
    {
      "source": "/Links",
      "destination": "/links.html"
    },
    {
      "source": "/links.html",
      "destination": "/links.html"
    },
    {
      "source": "/link",
      "destination": "/link.html"
    },
    {
      "source": "/Link",
      "destination": "/link.html"
    },
    {
      "source": "/link.html",
      "destination": "/link.html"
    },
    {
      "source": "/linkk",
      "destination": "/link.html"
    },
    {
      "source": "/Linkk",
      "destination": "/link.html"
    },
    {
      "source": "/linkk.html",
      "destination": "/link.html"
    },
    {
      "source": "/trackmaster",
      "destination": "/trackmaster.html"
    },
    {
      "source": "/Trackmaster",
      "destination": "/trackmaster.html"
    },
    {
      "source": "/trackmaster.html",
      "destination": "/trackmaster.html"
    },
    {
      "source": "/trackmasterpro",
      "destination": "/trackmasterPro.html"
    },
    {
      "source": "/trackmasterPro",
      "destination": "/trackmasterPro.html"
    },
    {
      "source": "/trackmasterpro.html",
      "destination": "/trackmasterPro.html"
    },
    {
      "source": "/trackmasterpro-light",
      "destination": "/trackmasterProLight.html"
    },
    {
      "source": "/trackmasterProLight",
      "destination": "/trackmasterProLight.html"
    },
    {
      "source": "/trackmasterprolight",
      "destination": "/trackmasterProLight.html"
    },
    {
      "source": "/trackmasterprolight.html",
      "destination": "/trackmasterProLight.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/faq",
      "destination": "/faq.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/refund",
      "destination": "/refund.html"
    },
    {
      "source": "/shipping",
      "destination": "/shipping.html"
    },
    {
      "source": "/delivery",
      "destination": "/shipping.html"
    }
  ],
  "headers": [
    {
      "source": "/videos/:file*",
      "headers": [
        {
          "key": "Content-Type",
          "value": "video/mp4"
        },
        {
          "key": "Accept-Ranges",
          "value": "bytes"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}