{
  "version": 2,
  "rewrites": [
    {
      "source": "/videos/:file*",
      "destination": "/api/video?file=:file*"
    }
  ],
  "headers": [
    {
      "source": "/videos/:file*",
      "headers": [
        {
          "key": "Content-Type",
          "value": "video/mp4"
        },
        {
          "key": "Accept-Ranges",
          "value": "bytes"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
}